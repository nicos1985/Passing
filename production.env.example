# Example only. Store real values in a root-owned mode-600 systemd EnvironmentFile.
DJANGO_SETTINGS_MODULE=passing.production
PYTHONNOUSERSITE=1
DJANGO_SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_SIGNING_KEY_OF_AT_LEAST_50_CHARACTERS
CRYPTOGRAPHY_KEY=KEEP_CURRENT_FERNET_KEY_UNTIL_DATA_IS_REENCRYPTED
DJANGO_ALLOWED_HOSTS=passing.example.com
# Current PostgreSQL 14 connection. The postgres login role is a superuser;
# see docs/postgres-cutover.md before changing these values to passing_app/passing.
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=postgres
DJANGO_DB_USER=REPLACE_WITH_EXISTING_DATABASE_USER
DJANGO_DB_PASSWORD=REPLACE_WITH_EXISTING_DATABASE_PASSWORD_IF_USED
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432
DJANGO_MEDIA_ROOT=/home/Passing/media
# Only behind a private Unix socket and a proxy that overwrites these headers:
DJANGO_TRUST_PROXY_HTTPS=1
DJANGO_TRUSTED_PROXY_IPS=unix
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=REPLACE_WITH_SMTP_ACCOUNT
EMAIL_HOST_PASSWORD=REPLACE_WITH_NEW_APP_PASSWORD
DEFAULT_FROM_EMAIL=REPLACE_WITH_FROM_ADDRESS
RECAPTCHA_PUBLIC_KEY=REPLACE_WITH_SITE_KEY
RECAPTCHA_PRIVATE_KEY=REPLACE_WITH_PRIVATE_KEY
