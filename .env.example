# .env.example - copy to .env and fill values for your environment

GOOGLE_OAUTH_CLIENT_ID = 
GOOGLE_OAUTH_CLIENT_SECRET = 

# DEV (central):
BROKER_BASE_URL =
BROKER_GOOGLE_REDIRECT_URI = 
# PROD ejemplo:
# BROKER_BASE_URL = "https://auth.passing.anima.bot"
# BROKER_GOOGLE_REDIRECT_URI = "https://auth.passing.anima.bot/sso/google/callback"

# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=

# Django
SECRET_KEY=
DJANGO_DEBUG=1
ALLOWED_HOSTS=
HUB_ORIGIN=http://localhost:8000
TENANT_BASE_URL=localhost:8000
TENANT_SCHEME=http
CSRF_TRUSTED_ORIGINS=
# Set to 1 only if the trusted HTTPS proxy overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_HTTPS=0
DJANGO_HSTS_SECONDS=0
# Database
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=

# Cryptography (Fernet URL-safe base64 key)
CRYPTOGRAPHY_KEY=

# Email / Brevo
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
EMAIL_HOST=
EMAIL_BACKEND=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
BREVO_API_KEY=

# Monitoring / Bitrix24 inbound webhook (CRM read and create)
MONITORING_BITRIX_WEBHOOK_URL=

# ReCaptcha
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
RECAPTCHA_TESTING=1
DOCMANAGER_WEBHOOK_TOKEN=

# Optional
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=
