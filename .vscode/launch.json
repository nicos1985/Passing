    "version": "0.2.0",
    "configurations": [
        {
            "name": "Passing local (2FA)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\manage.py",
            "args": [
                "runserver",
                "127.0.0.1:8000",
                "--settings=passing.local"
            ],
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "django": true,
            "justMyCode": true
        }
    ]
}
